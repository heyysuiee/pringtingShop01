# Production (Docker) settings. For local development, copy this file to .env in the project root,
# set PRINTSHOP_ENVIRONMENT=development, and configure PRINTSHOP_ADMIN_EMAIL plus
# PRINTSHOP_ADMIN_PASSWORD_HASH (there is no demo password). SMTP is needed only for email codes.
# Set PRINTSHOP_ENV_FILE to load a different file, or to an empty value to ignore .env entirely.
PRINTSHOP_ENVIRONMENT=production
# Signs session cookies and password-reset data. Keep it stable: changing it (or leaving it blank in
# development, which uses a temporary key) signs every customer out on restart.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
PRINTSHOP_SECRET_KEY=
PRINTSHOP_ADMIN_EMAIL=
# A PBKDF2 hash, not the password itself. Generate with: python -m backend.app.core.generate_admin_hash
PRINTSHOP_ADMIN_PASSWORD_HASH=
# PRINTSHOP_ORDER_DB is a legacy alias for PRINTSHOP_DATABASE_PATH; do not set both.
PRINTSHOP_DATABASE_PATH=/data/orders.sqlite3
PRINTSHOP_UPLOAD_DIR=/data/order_uploads
PRINTSHOP_ALLOWED_HOSTS=localhost,127.0.0.1
PRINTSHOP_CORS_ORIGINS=
# Set to https when a TLS-terminating proxy sits in front of the app: same-origin checks then compare
# browser https Origins correctly even though the internal ASGI scheme is http.
PRINTSHOP_PUBLIC_SCHEME=
# Comma-separated direct proxy addresses whose X-Forwarded-For/X-Real-IP headers may be trusted.
# Leave empty when the proxy is not known: forwarded headers are then ignored for rate limiting.
PRINTSHOP_TRUSTED_PROXY_IPS=
# Optional comma-separated allow-list of payment-provider host names (suffix matches included).
PRINTSHOP_GATEWAY_ALLOWED_HOSTS=
# Backups are signed with this key. Leave blank to use PRINTSHOP_SECRET_KEY; set a dedicated stable
# value so session-secret rotation does not make old backups unrestorable. Production requires >=32 chars.
PRINTSHOP_BACKUP_SIGNING_KEY=
# Comma-separated retired backup signing keys, kept only so older backups can still be restored after rotation.
PRINTSHOP_BACKUP_PREVIOUS_SIGNING_KEYS=

# Outbound email for registration and forgot-password verification codes (SMTP with STARTTLS).
# Production requires these settings because new accounts must prove they own their email address.
# Set PRINTSHOP_REQUIRE_EMAIL_VERIFICATION=false only for development/testing without SMTP.
PRINTSHOP_REQUIRE_EMAIL_VERIFICATION=true
# Gmail example: host smtp.gmail.com, port 587, your address as username and sender, and a Google app password.
# Port 465 uses implicit TLS. Check the settings with: python -m backend.app.core.send_test_email you@example.com
PRINTSHOP_SMTP_HOST=
PRINTSHOP_SMTP_PORT=587
PRINTSHOP_SMTP_USERNAME=
PRINTSHOP_SMTP_PASSWORD=
PRINTSHOP_SMTP_FROM=
PRINTSHOP_SMTP_STARTTLS=true

# AI customer support chatbot (Google Gemini). Create a key at https://aistudio.google.com/app/apikey.
# The key is used only by the server and is never sent to browsers. Leave it blank to run the chatbot
# without AI (it then answers from the database only). On Vercel, add it under Project > Settings > Environment Variables.
# GOOGLE_API_KEY is accepted as an alias for GEMINI_API_KEY when only the generic name is available.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Upload limits in megabytes per file. Tarpaulin / large-format orders accept larger print files.
# PRINTSHOP_LARGE_UPLOAD_CATEGORIES lists the catalog category ids that use the larger limit.
PRINTSHOP_MAX_UPLOAD_MB=5
PRINTSHOP_LARGE_FORMAT_MAX_UPLOAD_MB=25
PRINTSHOP_LARGE_UPLOAD_CATEGORIES=large-format
# Where order files are kept: disk (PRINTSHOP_UPLOAD_DIR, needs a persistent volume) or database.
# Leave blank for the default: database when TURSO_DATABASE_URL is set (Vercel), otherwise disk.
# Production refuses disk storage on Vercel/Turso or in a temporary directory: use a persistent volume
# or set PRINTSHOP_FILE_STORAGE=database.
PRINTSHOP_FILE_STORAGE=
# Vercel uses Turso (hosted SQLite) so every serverless copy shares the same data. Leave both blank
# for local development or Docker with a persistent SQLite volume. Keep the token out of source control.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# OCR-assisted receipt scanning. none disables it; auto uses Tesseract when installed and otherwise
# keeps every receipt in the normal admin review queue. Tesseract is optional, never required to pay.
PRINTSHOP_OCR_ENGINE=auto
# The Docker image ships only the English Tesseract language pack; other values fall back to admin
# review in that image. Add the matching tesseract-ocr-<lang> package at build time if you need them.
PRINTSHOP_OCR_LANGUAGE=eng
PRINTSHOP_OCR_MAX_MB=5
PRINTSHOP_OCR_TIMEOUT_SECONDS=20
