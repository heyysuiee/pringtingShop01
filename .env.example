# Production (Docker) settings. For local development, copy this file to .env in the project root
# and set PRINTSHOP_ENVIRONMENT=development; only the SMTP lines are then needed for password resets.
PRINTSHOP_ENVIRONMENT=production
# Signs session cookies and password-reset data. Keep it stable: changing it (or leaving it blank in
# development, which uses a temporary key) signs every customer out on restart.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
PRINTSHOP_SECRET_KEY=
PRINTSHOP_ADMIN_EMAIL=
# A PBKDF2 hash, not the password itself. Generate with: python -m backend.app.core.generate_admin_hash
PRINTSHOP_ADMIN_PASSWORD_HASH=
PRINTSHOP_DATABASE_PATH=/data/orders.sqlite3
PRINTSHOP_UPLOAD_DIR=/data/order_uploads
PRINTSHOP_ALLOWED_HOSTS=localhost,127.0.0.1
PRINTSHOP_CORS_ORIGINS=

# Outbound email for forgot-password verification codes (SMTP with STARTTLS).
# Leave PRINTSHOP_SMTP_HOST and PRINTSHOP_SMTP_FROM blank to disable email (reset requests then return 503).
# Gmail example: host smtp.gmail.com, port 587, your address as username and sender, and a Google app password.
# Port 465 uses implicit TLS. Check the settings with: python -m backend.app.core.send_test_email you@example.com
PRINTSHOP_SMTP_HOST=
PRINTSHOP_SMTP_PORT=587
PRINTSHOP_SMTP_USERNAME=
PRINTSHOP_SMTP_PASSWORD=
PRINTSHOP_SMTP_FROM=
PRINTSHOP_SMTP_STARTTLS=true
